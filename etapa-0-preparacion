        "from itertools import count\n",
        "# Ejercicio 5\n",
        "\n",
        "precios = [100, 102, 101, 105, 103, 99, 104]\n",
        "\n",
        "Limite = len(precios) - 1\n",
        "i = 1\n",
        "k = 0\n",
        "\n",
        "RendimientosLista = []\n",
        "cant_subidas = 0\n",
        "cant_bajadas = 0\n",
        "dias_positivos = 0\n",
        "\n",
        "while i <= Limite:\n",
        "  # Definición de Variables Internas\n",
        "  b = i - 1\n",
        "  PrecioActual = precios[i]\n",
        "  PrecioAnterior = precios[b]\n",
        "\n",
        "  rendimiento = round(((PrecioActual - PrecioAnterior) / PrecioAnterior) * 100, 2)\n",
        "\n",
        "  RendimientosLista.append(rendimiento)\n",
        "\n",
        "  i = i + 1\n",
        "\n",
        "\n",
        "while k < len(RendimientosLista) - 1:\n",
        "  c = k + 1\n",
        "  rendimiento_actual = RendimientosLista[k]\n",
        "  rendimiento_posterior = RendimientosLista[c]\n",
        "\n",
        "  if rendimiento_posterior > rendimiento_actual:\n",
        "    cant_subidas += 1\n",
        "  elif rendimiento_posterior < rendimiento_actual:\n",
        "    cant_bajadas += 1\n",
        "\n",
        "  if RendimientosLista[k - 1] > 0:\n",
        "    dias_positivos += 1\n",
        "\n",
        "  k = k + 1\n",
        "\n",
        "print(RendimientosLista)\n",
        "\n",
        "print(cant_subidas, cant_bajadas)\n",
        "\n",
        "print(\n",
        "    f\"Veces que subio: {cant_subidas} \"\n",
        "    f\"Veces que bajaron: {cant_bajadas} \"\n",
        "    f\"Promedio de días positivos: {dias_positivos / len(RendimientosLista)}%\"\n",
        ")\n"
      ],
